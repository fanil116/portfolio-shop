# Скопируйте в .env: cp .env.template .env
# Значения ниже подходят только для локальной разработки.

SITE_HOST=localhost
# Через запятую; по умолчанию SITE_HOST,localhost,127.0.0.1,backend
ALLOWED_HOSTS=
DEBUG=True
API_DOCS_ENABLE=True
SECRET_KEY=local-dev-secret-key-change-me

# Origins, с которых разрешены запросы с CSRF-токеном (через запятую).
# Для локального Nuxt dev-сервера нужен http://localhost:3000.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost
# Secure-флаг у cookie сессии/CSRF вне DEBUG. False — только для стека без HTTPS.
COOKIE_SECURE=False

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379

# Почта (в DEBUG письма пишутся в консоль backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Sentry (необязательно)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# nginx (production-compose): basic-auth на /admin/, формат user:{PLAIN}password
ADMIN_HTPASSWD=admin:{PLAIN}admin

# Frontend: адрес backend для SSR-запросов и dev-прокси Nuxt
NUXT_API_INTERNAL_URL=http://localhost:8000
